# Figma Code Connect Configuration
# 
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (add to .gitignore)

# Your Figma Personal Access Token
# Generate from: https://www.figma.com/developers
# Keep this SECRET - never share or commit it
FIGMA_TOKEN=your_figma_personal_access_token_here
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token_here

# Your Figma File Key (found in the URL)
# Example URL: https://www.figma.com/file/ABC123/Your-Design-System
# FILE_KEY would be: ABC123
FIGMA_FILE_KEY=your_figma_file_key_here

# Optional: Figma Team ID (if using team files)
# FIGMA_TEAM_ID=your_team_id_here

# Optional: GitHub token for CI/CD
# GITHUB_TOKEN=your_github_token_here
